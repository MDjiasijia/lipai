{
  "name": "lipai-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "电子立牌本地管理工具：纯本地服务 + Web 控制台。原生蓝牙桥常驻轮播/场景日程，Web Bluetooth 双通道直连；兼容 lipai v2 分享文件（导入/导出），无登录、无云端依赖。",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:web": "vite --port 5174 --host 127.0.0.1",
    "dev:server": "node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run build && node --import tsx scripts/build-release.ts",
    "preview": "vite preview --port 5174 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "start": "node --import tsx scripts/start.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@napi-rs/canvas": "^1.0.9",
    "hono": "^4.13.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.5"
  }
}
